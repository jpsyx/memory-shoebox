# Copy to apps/server/.env.local and fill in. `pnpm dev` and `pnpm migrate`
# load that file automatically. It is gitignored: never commit real values.
#
# In production these are set as Fly.io secrets instead
# (`fly secrets set ...`), not from a file. See docs/deployment.md.

# --- Sessions -----------------------------------------------------------
# Encrypts the login cookie. Must be at least 32 characters.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# --- Backblaze B2 -------------------------------------------------------
# Create an application key scoped to a single private bucket, then copy the
# keyID and applicationKey here. The applicationKey is shown only once.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# The S3-compatible endpoint and region of your bucket, shown in the B2 console
# next to the bucket (for example s3.us-west-004.backblazeb2.com).
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
# Optional. Key prefix for thumbnails Memory Shoebox generates.
# B2_THUMBNAIL_PREFIX=.memory-shoebox-thumbnails

# --- Email (Resend) -----------------------------------------------------
# Transactional mail: the six-digit sign-in code and every notification.
# Not read by the server yet; authentication is not built. Listed here because
# a deployment without working mail cannot let anybody sign in, including you.
# Create a key at https://resend.com and verify the sending domain first.
# RESEND_API_KEY=
# MAIL_FROM="Memory Shoebox <hello@your-domain.example>"

# --- Server -------------------------------------------------------------
# Optional. Defaults shown.
# PORT=8080
# HOST=0.0.0.0
# DATABASE_PATH=./data/memory-shoebox.db
