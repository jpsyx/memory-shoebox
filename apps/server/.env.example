# Copy to apps/server/.env.local and fill in. `pnpm dev` and `pnpm migrate`
# load that file automatically. It is gitignored: never commit real values.
#
# Production: copy to .env.server.production at the repository root.
# pnpm run deploy imports these as staged Fly runtime secrets over stdin.
# Set NODE_ENV=production and DATABASE_PATH within FLY_MOUNT_PATH.
# Values are single-line dotenv data, with literal backslashes and dollars.
# See docs/deployment.md.

# --- Sessions -----------------------------------------------------------
# The one secret this instance needs. Must be at least 32 characters.
# Generate one with: openssl rand -hex 32
#
# It protects the six-digit sign-in codes: they are stored as an HMAC under a
# pepper derived from this value, so a copied database file is worth nothing
# during the ten minutes a code is alive. The session cookie is not encrypted
# with it, and does not need to be: the cookie is an opaque random token whose
# only meaning is a row in the database.
#
# Changing it invalidates every live sign-in code and no session.
SESSION_SECRET=

# --- Backblaze B2 -------------------------------------------------------
# Create an application key scoped to a single private bucket, then copy the
# keyID and applicationKey here. The applicationKey is shown only once.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# The S3-compatible endpoint and region of your bucket, shown in the B2 console
# next to the bucket (for example s3.us-west-004.backblazeb2.com).
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
# Optional. The folder every object of this instance lives in, inside the one
# bucket, so that test and production files are never mixed. Unset, it is
# `production` when NODE_ENV is `production` and `test` otherwise, which is
# what you want. One or more lowercase segments of a-z, 0-9 and `-`, joined by
# `/`, with no slash at either end. An empty value is refused, because only an
# empty prefix could write at the bucket's root. See docs/configuration.md.
# B2_KEY_PREFIX=test
# Optional. Key prefix for thumbnails Memory Shoebox generates.
# B2_THUMBNAIL_PREFIX=.memory-shoebox-thumbnails

# --- Email (Resend) -----------------------------------------------------
# Transactional mail: the six-digit sign-in code and every notification.
# Optional. Without it the server still starts and serves normally.
# A key on its own is not enough to send. The sending address has to be set as
# well, and while the Shoebox's public base URL is unset every message is
# written `failed` rather than queued: nothing is waiting to go out. Both are
# settings rather than variables, and the surface that writes them is not built
# yet. See docs/mail.md.
# Create a key at https://resend.com and verify your sending domain there.
RESEND_API_KEY=
#
# The sending identity is NOT an environment variable. It is the
# `mail.from_address` and `mail.from_name` settings, edited on the Shoebox
# settings surface, so that the mail health banner has one place to point at
# when it is missing. See docs/mail.md.

# --- Local email (development only) --------------------------------------
# Write every message as a PDF in ~/Downloads/memory-shoebox-emails instead of
# sending it. The whole path runs as it would in production, including the
# rendering and the queue, and only the last step changes, so the PDF is the
# message somebody would have received.
#
# Needs NODE_ENV to say development or test. Anything else, including leaving
# it unset, sends for real instead, because a gate that guesses in the
# permissive direction is one a live instance can fall through: it would look
# perfectly healthy while every sign-in code went to a file on the server.
#
# Needs a browser: run this once, from the repository root.
#   pnpm --filter @memory-shoebox/server exec playwright install chromium
#
# **The only value that turns this on is the exact string `true`.** Empty,
# unset, `1`, `yes` and `TRUE` all mean off, and none of them warns you: the
# parse is `value === "true"`. Left as it ships below, faking is off.
#
# Off does not mean broken. Where mail actually goes is decided by three
# things together, and every outcome below is a state this product runs in:
#
#   FAKE   NODE_ENV      RESEND_API_KEY   what happens
#   -----  ------------  ---------------  -----------------------------------
#   true   development   anything         PDF in ~/Downloads, nothing sent
#   true   production    set              sent for real: the flag is IGNORED
#   off    anything      set              sent for real, through Resend
#   off    anything      empty            queued and left there, nothing sent
#
# The second row is the guard, not a bug. A live instance quietly writing PDFs
# would look healthy to everyone except the person waiting for a code, so only
# `development` or `test` may honour the flag; every other value, unset
# included, counts as production and sends.
#
# The fourth row is the state a fresh instance starts in, and is not an error:
# an admin has to reach the settings surface to configure mail at all, so the
# queue simply waits. It is also what the end-to-end suite runs in, which is
# how a test can read a sign-in code straight out of the row that holds it.
NODE_ENV=development
ENABLE_FAKE_EMAIL=

# --- Upstash (rate limiting) ---------------------------------------------
# Resend allows two requests a second, and that budget belongs to the API key
# rather than to this process, so a script running beside the server spends
# from the same one. With these set, the limit is enforced across everything
# using the key. Without them the same window is enforced in memory, which is
# correct for a single machine and is what a self-hoster will run.
#
# Create a Redis database at https://upstash.com and copy the REST URL and
# token from its console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Server -------------------------------------------------------------
# Optional. Defaults shown.
PORT=8080
HOST=0.0.0.0
DATABASE_PATH=./data/memory-shoebox.db
# Optional. Override where the server finds the built web app.
# WEB_DIST_PATH=/app/apps/web/dist
