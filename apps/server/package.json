{
  "name": "@memory-shoebox/server",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env.local src/index.ts",
    "start": "node src/index.ts",
    "build": "echo \"@memory-shoebox/server runs TypeScript directly; nothing to build\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node --env-file-if-exists=.env.local src/db/migrate.ts",
    "seed:member": "node --env-file-if-exists=.env.local scripts/seedMember.ts",
    "seed:archive": "node --env-file-if-exists=.env.local scripts/seedArchive.ts",
    "b2:cors": "node --env-file-if-exists=.env.local scripts/configureBucketCors/configureBucketCors.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.917.0",
    "@aws-sdk/s3-request-presigner": "^3.917.0",
    "@fastify/static": "^8.2.0",
    "@memory-shoebox/emails": "workspace:*",
    "@memory-shoebox/shared": "workspace:*",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.35.0",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1",
    "kysely": "^0.28.8",
    "resend": "^6.30.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "playwright": "^1.50.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
