{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "react": ["../../apps/web/node_modules/@types/react"],
      "react-dom/*": ["../../apps/web/node_modules/@types/react-dom/*"],
      "@tabler/icons-react": [
        "../../apps/web/node_modules/@tabler/icons-react"
      ],
      "@videojs/react": [
        "../../apps/web/node_modules/@videojs/react/dist/dev/index.d.ts"
      ],
      "@videojs/react/video": [
        "../../apps/web/node_modules/@videojs/react/dist/dev/presets/video/index.d.ts"
      ]
    }
  },
  "include": ["*.ts", "*.tsx"]
}
