{
  "name": "famgram",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -b",
    "preview": "vite preview",
    "type-check": "tsc -b --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "skills": "tsx scripts/skills/SkillsCli.ts",
    "skills:install": "tsx scripts/skills/SkillsCli.ts install",
    "skills:update": "./scripts/skills/update-skills.sh",
    "postinstall": "tsx scripts/skills/SkillsCli.ts install --quiet",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm test"
  },
  "dependencies": {
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "clsx": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "@tanstack/react-router": "^1.170.18"
  },
  "devDependencies": {
    "@avandar/acclimate": "^0.4.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "postcss": "^8.5.16",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.11",
    "@tanstack/router-plugin": "^1.168.23"
  },
  "packageManager": "pnpm@10.30.3"
}
