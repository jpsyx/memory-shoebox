{
  "name": "memory-shoebox",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Self-hosted private photo and video sharing for families.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm env:sync && pnpm --filter @memory-shoebox/emails build && pnpm --parallel --filter \"./apps/*\" --filter @memory-shoebox/emails dev",
    "dev:web": "pnpm env:sync web && pnpm --filter @memory-shoebox/web dev",
    "dev:server": "pnpm env:sync server && pnpm --filter @memory-shoebox/emails build && pnpm --filter @memory-shoebox/server dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @memory-shoebox/web preview",
    "start": "pnpm --filter @memory-shoebox/server start",
    "migrate": "pnpm --filter @memory-shoebox/server migrate",
    "reset-env": "tsx scripts/env/reset-env.ts",
    "env:sync": "tsx scripts/env/sync-env.ts",
    "seed:member": "pnpm --filter @memory-shoebox/server seed:member",
    "seed:archive": "pnpm --filter @memory-shoebox/server seed:archive",
    "b2:cors": "pnpm --filter @memory-shoebox/server b2:cors",
    "upload:proof": "tsx scripts/upload-proof/uploadProof.ts",
    "type-check": "pnpm --filter @memory-shoebox/emails build && tsc --noEmit && pnpm -r type-check",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run && pnpm -r test",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "skills": "tsx scripts/skills/SkillsCli.ts",
    "skills:install": "tsx scripts/skills/SkillsCli.ts install",
    "skills:check": "./scripts/skills/install-local-skills.sh --check",
    "skills:local": "./scripts/skills/install-local-skills.sh",
    "skills:update": "./scripts/skills/update-skills.sh",
    "postinstall": "sh scripts/skills/postinstall.sh",
    "check": "pnpm skills:check && pnpm format:check && pnpm lint && pnpm type-check && pnpm build && pnpm test",
    "media:generate": "tsx e2e/fixtures/cartoon-media/generator/makeCartoonMedia.ts",
    "test:e2e:admin": "pnpm build && playwright test -c playwright.admin.config.ts",
    "test:e2e:video": "pnpm build && playwright test -c playwright.video.config.ts",
    "deploy": "tsx scripts/deploy/deploy.ts"
  },
  "devDependencies": {
    "@avandar/acclimate": "^0.4.0",
    "@memory-shoebox/shared": "workspace:*",
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.1.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
