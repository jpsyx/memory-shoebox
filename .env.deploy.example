# Copy to .env.deploy in the repository root. Never commit operator values.
# Create this app and exactly one volume before running pnpm run deploy.
FLY_APP=
FLY_REGION=
FLY_VOLUME_NAME=shoebox_data
FLY_MOUNT_PATH=/data
FLY_VM_SIZE=shared-cpu-1x
FLY_VM_MEMORY_MB=512
# Set 1 to stay warm; 0 permits idle suspension/stopping.
FLY_MIN_MACHINES_RUNNING=0
FLY_AUTO_STOP_MACHINES=suspend
# Optional: blank uses fly auth login credentials, not an inherited env token.
FLY_API_TOKEN=
