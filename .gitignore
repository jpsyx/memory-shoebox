# Environment
.env
.env.*
!**/.env.example
!.env.deploy.example
.superpowers/

# Local SQLite catalog. Anchored rather than bare: an unanchored `data/` also
# matches any directory called data anywhere in the tree, which silently
# swallowed generated fixtures. Two anchors are needed because
# DATABASE_PATH defaults to `./data/memory-shoebox.db`, relative to whatever
# directory the process starts in: the repository root for `pnpm migrate`, and
# `apps/server` for `pnpm dev:server`.
/data/
/apps/server/data/

# Private, machine-local agent notes. Never committed.
CLAUDE.local.md

# Agent skills are tracked, not ignored. `.agents/skills` holds the real skill
# folders and every per-frontend directory is symlinks into it, so a clone gets
# the exact skill set this project expects without a network call. Only
# genuinely machine-local files stay out.
.claude/settings.local.json

# Difit session comments
.difit/

# Belt and braces. No raw photograph or video belongs anywhere in this
# repository: the archive's media lives in the owner's own object storage, and
# nothing here has ever tracked one. This rule exists so that a stray capture,
# a pasted screenshot or a `git add -A` in the wrong directory cannot make that
# untrue by accident. Add an exception deliberately if one is ever needed.
*.jpg
*.jpeg
*.heic
*.heif
*.mov
*.mp4

# Committed generated cartoon media, never family captures.
!e2e/fixtures/cartoon-media/web/*.jpg
!e2e/fixtures/cartoon-media/web/*.mp4
e2e/fixtures/cartoon-media/.cartoon-work/

# Deliberate exception: the upload spec's fixtures are generated test patterns
# and flat-colour drawings, not captures, and are small. They are written by
# `e2e/fixtures/upload/makeUploadFixtures/makeUploadFixtures.ts`, which says what each one is for.
# Each is named exactly, so a real photo dropped into that folder stays ignored:
# a new fixture must be added here by name.
!e2e/fixtures/upload/portrait-orientation-6.jpg
!e2e/fixtures/upload/heic-rotated.heic
!e2e/fixtures/upload/IMG-20260503-WA0001.jpg
!e2e/fixtures/upload/h264-clip.mp4
!e2e/fixtures/upload/hevc-clip.mov

# Impeccable review captures: rendered from the real family photos, so they
# carry the same images. The design tooling's config and surface briefs are
# committed; only the captures are not.
.impeccable/review/

# The end-to-end run's output. Its catalog needs no rule of its own: it lives
# in `/apps/server/data/`, which is already ignored above, and the web server
# command deletes it before every run. The report and the traces are written
# fresh per run.
/test-results/
/playwright-report/
