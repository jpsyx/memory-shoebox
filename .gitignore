# Environment
.env
.env.local*

# Local SQLite catalog. Anchored to the repository root: an unanchored
# `data/` also matches any directory called data anywhere in the tree, which
# silently swallowed the prototypes' fixtures.
/data/

# Private, machine-local agent notes. Never committed.
CLAUDE.local.md

# Agent skills. Only skills-lock.json is tracked: the project's skills tooling
# restores these directories from it (see scripts/skills). `.agents/skills`
# holds the real skill folders and every other directory here is a per-frontend
# link or copy.
.agents/
.claude/skills/
.claude/settings.local.json
.codex/
.cursor/agents/
.cursor/hooks.json
.cursor/skills/
.opencode/

# Difit session comments
.difit/

# Prototype media and review captures: real family photos. Never committed.
prototypes/public/media/
prototypes/.review/

# Impeccable review captures: rendered from the real family photos, so they
# carry the same images. The design tooling's config and surface briefs are
# committed; only the captures are not.
.impeccable/review/
