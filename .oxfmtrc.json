{
  "printWidth": 80,
  "semi": true,
  "tabWidth": 2,
  "importOrder": [
    "<BUILTIN_MODULES>",
    "<THIRD_PARTY_MODULES>",
    "^@/(.*)$",
    "^[.]",
    "<TYPES>"
  ],
  "sortPackageJson": false,
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".cursor/**",
    ".opencode/**",
    ".tanstack/**",
    "dist/**",
    "node_modules/**",
    "src/routeTree.gen.ts"
  ]
}
